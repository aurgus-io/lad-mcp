# Path to the LAD dashboard event store. Relative paths resolve from this repo root.
# This default assumes the LAD and lad-mcp repos are sibling folders.
LAD_EVENTS_FILE=../LAD/daemon/logs/dashboard_events.jsonl

# Optional: use streamable-http for a local tunnel / MCP Inspector.
# Keep the server on loopback unless you add authentication and TLS.
LAD_MCP_TRANSPORT=stdio
LAD_MCP_HOST=127.0.0.1
LAD_MCP_PORT=8787
